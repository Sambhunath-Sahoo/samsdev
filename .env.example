# Roadmap login and progress. Copy to .env.local and fill in. Never commit real values.

# Random 32+ char string. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URIs:
#   http://localhost:3003/api/auth/callback/google
#   https://sams-dev.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string (Neon console > Connection details).
DATABASE_URL=
